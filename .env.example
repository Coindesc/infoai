# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE: INFOAI DIGITAL NEWSPAPER
# Copie este arquivo para .env e preencha suas chaves
# ==============================================================================

# Porta da aplicação Node/Express
PORT=3000
NODE_ENV=production

# 1. Supabase (Banco de Dados de Assinantes e Edições)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui

# 2. Evolution API (WhatsApp Disparos)
EVOLUTION_API_URL=https://api-whatsapp.seudominio.com
EVOLUTION_API_KEY=sua-chave-api-evolution
EVOLUTION_INSTANCE_NAME=infoai-news

# 3. Disparo por E-mail (Resend ou SMTP)
RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM=redacao@infoai.com.br

